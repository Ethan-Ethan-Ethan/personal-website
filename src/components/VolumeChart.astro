---
/**
 * 交易量 K 線圖元件（TradingView Lightweight Charts）
 * Props:
 *   - data: 交易資料 JSON 路徑或陣列
 *   - height: 圖表高度（預設 400px）
 *   - symbol: 交易對名稱（預設 BTC/USDT）
 */

export interface Props {
  data: string | Array<{
    time: string;
    open: number;
    high: number;
    low: number;
    close: number;
    volume: number;
  }>;
  height?: number;
  symbol?: string;
}

const {
  data = '/assets/trading/btc-usdt.json',
  height = 400,
  symbol = 'BTC/USDT',
} = Astro.props;

const chartId = `chart-${Math.random().toString(36).slice(2, 9)}`;
const dataAttr = typeof data === 'string' ? data : JSON.stringify(data);
---

<div class="trading-chart" id={chartId} data-data={dataAttr} style={`height: ${height}px;`}></div>

<script>
  import { createChart, CandlestickSeries, HistogramSeries } from 'lightweight-charts';

  function themeColors() {
    // 單一來源：讀 data-theme 下的 CSS var（深/淺由全域 token 定義，此處零硬編碼色）。
    const css = getComputedStyle(document.documentElement);
    const pick = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
    return {
      bg: pick('--color-bg', '#11110f'),
      text: pick('--color-muted', '#b9b3a5'),
      line: pick('--color-line', '#37372f'),
      green: pick('--color-green', '#88b56b'),
      red: pick('--color-red', '#c46f5a'),
      blue: pick('--color-blue', '#76a7bd'),
    };
  }

  function chartOptions(c: ReturnType<typeof themeColors>) {
    return {
      layout: {
        background: { color: c.bg },
        textColor: c.text,
        fontFamily: 'Inter, sans-serif',
      },
      grid: {
        vertLines: { color: c.line },
        horzLines: { color: c.line },
      },
      crosshair: {
        mode: 0,
        vertLine: { color: c.green, labelBackgroundColor: c.green },
        horzLine: { color: c.green, labelBackgroundColor: c.green },
      },
      rightPriceScale: { borderColor: c.line },
      timeScale: { borderColor: c.line, timeVisible: true },
    };
  }

  function initVolumeChart(el: HTMLElement) {
    const raw = el.dataset.data;
    if (!raw) return;

    const c = themeColors();
    const chart = createChart(el, chartOptions(c));

    const candlestickSeries = chart.addSeries(CandlestickSeries, {
      upColor: c.green,
      downColor: c.red,
      borderUpColor: c.green,
      borderDownColor: c.red,
      wickUpColor: c.green,
      wickDownColor: c.red,
    });

    const volumeSeries = chart.addSeries(HistogramSeries, {
      color: c.blue,
      priceFormat: { type: 'volume' },
      priceScaleId: 'volume',
    });
    // 主題切換跟著走：data-theme 變就重讀 var 重上色（系列色重建，最穩）。
    const retheme = () => {
      const n = themeColors();
      chart.applyOptions(chartOptions(n));
      candlestickSeries.applyOptions({
        upColor: n.green, downColor: n.red,
        borderUpColor: n.green, borderDownColor: n.red,
        wickUpColor: n.green, wickDownColor: n.red,
      });
      volumeSeries.applyOptions({ color: n.blue });
    };
    const themeObserver = new MutationObserver((mutations) => {
      if (mutations.some((m) => m.attributeName === 'data-theme')) retheme();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    chart.priceScale('volume').applyOptions({
      scaleMargins: { top: 0.85, bottom: 0 },
    });

    const load = async () => {
      let chartData;
      if (raw.startsWith('/')) {
        const res = await fetch(raw);
        chartData = await res.json();
      } else {
        chartData = JSON.parse(raw);
      }
      candlestickSeries.setData(chartData.candles || []);
      volumeSeries.setData(chartData.volumes || []);
      chart.timeScale().fitContent();
    };
    load();

    const resizeObserver = new ResizeObserver(() => {
      chart.applyOptions({ width: el.clientWidth });
    });
    resizeObserver.observe(el);
  }

  document.querySelectorAll('.trading-chart').forEach(initVolumeChart);
</script>

<style>
  .trading-chart {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
</style>
