---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { buildArticleListing } from '../../features/articles/routing.mjs';

const articles = buildArticleListing(await getCollection('posts'))
  .sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf());
const posts = articles.map(({ post }) => post);

const categories = [...new Set(posts.map(p => p.data.category).filter(Boolean))];
const sources = [...new Set(posts.map(p => p.data.source))];

const sourceLabel = { manual: '原創', rss: 'RSS', gmail: 'Gmail' };
const sourceColor = { manual: 'text-green', rss: 'text-blue', gmail: 'text-amber' };
---

<BaseLayout title="文章 | Ethan" description="所有公開文章 — 工作經驗、AI 工作流、公開筆記與 RSS 聚合內容。">
  <Topbar />

  <main class="pt-16 max-w-[var(--container-wide)] mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
        <div>
          <h1 class="text-4xl font-bold tracking-tight mb-2">文章</h1>
          <p class="text-muted text-md">工作經驗、AI 工作流、公開筆記，以及自動聚合的 RSS 與 Gmail 文章。</p>
        </div>
        <a
          href="/articles/new"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-green text-bg font-semibold text-sm hover:bg-green/90 transition-colors shadow-card"
        >
          <span>＋</span> 發表新文章
        </a>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap gap-3">
        <button
          onclick="filterArticles('全部')"
          class="px-4 py-2 rounded-lg bg-panel border border-line text-xs font-medium hover:border-green transition-colors"
          id="filter-all"
        >
          全部 ({posts.length})
        </button>
        {categories.map(cat => (
          <button
            onclick={`filterArticles('${cat}')`}
            class="px-4 py-2 rounded-lg bg-panel border border-line text-xs font-medium hover:border-green transition-colors"
            id={`filter-${cat}`}
          >
            {cat}
          </button>
        ))}
        {sources.map(src => (
          <button
            onclick={`filterSource('${src}')`}
            class="px-4 py-2 rounded-lg bg-panel border border-line text-xs font-medium hover:border-green transition-colors"
            id={`filter-source-${src}`}
            style={{ color: `var(--color-${sourceColor[src]?.replace('text-', '') ?? 'soft'})` }}
          >
            {sourceLabel[src]}
          </button>
        ))}
      </div>
    </header>

    <!-- Post Grid -->
    <div
      id="article-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
    >
      {posts.map(post => (
        <PostCard post={post} />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <p class="text-muted text-lg">尚未發布任何文章。</p>
        <a
          href="/articles/new"
          class="mt-4 text-green hover:text-green/90 transition-colors font-medium"
        >
          發表第一篇文章 →
        </a>
      </div>
    )}
  </main>

  <Footer />

  <script>
    function filterArticles(category) {
      const cards = document.querySelectorAll('#article-grid > a');
      const btns = document.querySelectorAll('[id^="filter-"]:not([id^="filter-source-"])');
      btns.forEach(b => {
        b.className = 'px-4 py-2 rounded-lg bg-panel border border-line text-xs font-medium hover:border-green transition-colors';
      });
      document.getElementById('filter-' + category).className = 'px-4 py-2 rounded-lg bg-panel border border-green text-xs font-medium hover:border-green transition-colors';
      cards.forEach(card => {
        const catEl = card.querySelector('.text-soft');
        const match = category === '全部' || (catEl && catEl.textContent.includes(category));
        card.style.display = match ? 'block' : 'none';
      });
    }

    function filterSource(source) {
      const cards = document.querySelectorAll('#article-grid > a');
      const btns = document.querySelectorAll('[id^="filter-source-"]');
      btns.forEach(b => {
        b.className = 'px-4 py-2 rounded-lg bg-panel border border-line text-xs font-medium hover:border-green transition-colors';
      });
      document.getElementById('filter-source-' + source).className = 'px-4 py-2 rounded-lg bg-panel border border-green text-xs font-medium hover:border-green transition-colors';
      cards.forEach(card => {
        const sourceEl = card.querySelector('.text-xs.font-medium');
        const match = sourceEl && sourceEl.textContent.includes({ manual: '原創', rss: 'RSS', gmail: 'Gmail' }[source]);
        card.style.display = match ? 'block' : 'none';
      });
    }
  </script>
</BaseLayout>