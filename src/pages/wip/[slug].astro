---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import { WIP_NOTES, wipBySlug } from '../../features/workspace/core/article-wip';

export function getStaticPaths() {
  return WIP_NOTES.map((note) => ({ params: { slug: note.slug } }));
}

const { slug } = Astro.params;
const note = wipBySlug(slug ?? '');
const title = note?.title ?? '尚未完成的筆記';
---

<BaseLayout title={`${title}｜建構中`} description="這篇筆記還在建構中。">
  <Topbar />
  <main class="pt-14 min-h-[70vh] px-4 py-16 flex items-center justify-center">
    <div class="w-full max-w-[var(--container-narrow)] text-center">
      <span class="inline-block text-[11px] tracking-[0.14em] uppercase text-muted border border-line rounded-full px-2.5 py-1 mb-5">
        建構中
      </span>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight leading-snug mb-4">{title}</h1>
      <p class="text-muted text-sm sm:text-base leading-relaxed mb-8">
        這則延伸閱讀還沒寫完。標題先留著，正文稍後補上。
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        <a href="/articles/harness-not-claude" class="text-blue hover:text-green transition-colors">← 回到 Harness 一文</a>
        <a href="/" class="text-muted hover:text-text transition-colors">首頁</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
