---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkspaceDesktop from '../components/workspace/WorkspaceDesktop';
import LakeCanvas from '../components/workspace/LakeCanvas';
import publicContent from '../data/generated/public-content.json';
import { getCollection } from 'astro:content';
import { getArticleHref } from '../features/articles/routing.mjs';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const homepageContent = publicContent.items.map(({ sourceHash: _sourceHash, ...item }) => item);
const recentArticles = posts.slice(0, 6).map((post) => ({
  title: post.data.title,
  href: getArticleHref(post),
  category: post.data.category,
}));
// Task 2: lake mount behind flag (default off → behavior unchanged; flip in Task 5 with overlay)
const USE_LAKE = false;
---

<BaseLayout title="Ethan Yang｜AI 系統創作者" description="建立可驗證、可組合並能持續演化的 AI、知識圖譜、影片理解與量化研究系統。">
  {USE_LAKE
    ? <LakeCanvas client:load phase={0} />
    : <WorkspaceDesktop client:load content={homepageContent} recentArticles={recentArticles} />}
  <noscript>
    <section class="nojs-workspace" aria-label="網站導覽">
      <h1>Ethan Yang｜AI 系統創作者</h1>
      <p>目前瀏覽器未啟用 JavaScript；仍可直接瀏覽公開內容。</p>
      <nav><a href="/articles/">Articles</a><a href="/trading/">Trading Lab</a><a href="/resume">Resume</a></nav>
    </section>
  </noscript>
</BaseLayout>
