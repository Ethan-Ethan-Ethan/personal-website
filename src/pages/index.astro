---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkspaceDesktop from '../components/workspace/WorkspaceDesktop';
import LakeLanding from '../components/workspace/LakeLanding';
import AboutDialog from '../components/AboutDialog.astro';
import publicContent from '../data/generated/public-content.json';
import { getCollection } from 'astro:content';
import { getArticleHref } from '../features/articles/routing.mjs';
import { sortArticleCatalog } from '../features/workspace/core/article-catalog';
import { parseArticleLakeBody } from '../features/workspace/core/article-lake-parse';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const articleCatalog = sortArticleCatalog(
  posts.map((post) => {
    const { intro, cards } = parseArticleLakeBody(post.body ?? '');
    return {
      title: post.data.title,
      href: getArticleHref(post),
      date: post.data.date.toISOString().slice(0, 10),
      category: post.data.category ?? '公開筆記',
      summary: post.data.description ?? '',
      pinned: post.data.pinned ?? false,
      intro,
      cards,
    };
  }),
);
const postsByDate = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const homepageContent = publicContent.items.map(({ sourceHash: _sourceHash, ...item }) => item);
const recentArticles = postsByDate.slice(0, 6).map((post) => ({
  title: post.data.title,
  href: getArticleHref(post),
  category: post.data.category,
}));
// Task 5: lake live（開關已開；push／merge 另批）。回滾：改回 false。
const USE_LAKE = true;
---

<BaseLayout title="Ethan｜AI 系統創作者" description="建立可驗證、可組合並能持續演化的 AI、知識圖譜、影片理解與量化研究系統。">
  {USE_LAKE
    ? <LakeLanding client:load articleCatalog={articleCatalog} />
    : <WorkspaceDesktop client:load content={homepageContent} recentArticles={recentArticles} />}
  <AboutDialog />
  <noscript>
    <section class="nojs-workspace" aria-label="網站導覽">
      <h1>Ethan｜AI 系統創作者</h1>
      <p>目前瀏覽器未啟用 JavaScript；仍可直接瀏覽公開內容。</p>
      <nav><a href="/articles/">Articles</a><a href="/trading/">Trading Lab</a><a href="/resume">Resume</a></nav>
    </section>
  </noscript>
</BaseLayout>
