---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Vlog | Ethan">
  <Topbar />
  <main class="pt-14 max-w-[var(--container-default)] mx-auto px-4 py-20 text-center">
    <h1 class="text-2xl font-bold mb-4">Vlog</h1>
    <!-- 2026-10-18: Access 閘門佔位 by-design（內容未公開；公開 vlog 素材見 vlog/ 目錄，待定義是否掛頁） -->
    <p class="text-muted">此頁面由 Cloudflare Access 保護。</p>
    <p class="text-sm text-soft mt-4">請透過 Cloudflare Access 驗證後存取 Vlog 內容。</p>
  </main>
  <Footer />
</BaseLayout>
